{
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/session-end-forge.sh",
            "timeout": 120000
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read **",
      "Write **",
      "Edit **",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(chmod *)"
    ]
  }
}
